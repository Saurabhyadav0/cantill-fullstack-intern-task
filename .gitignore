# ---------------------------------------------------------------------------
# TASK RULE: the public repo must NOT contain the task data files.
# Everything the kit shipped (master data, contracts, PR batches, policy PDFs,
# and the policy encoded as data) stays local and is ignored here.
# See data/README.md for how to place the kit locally.
# ---------------------------------------------------------------------------
data/*
!data/README.md
docs/policy-v5*.json
*.pdf
*.csv

# Secrets / env
.env
.env.*
!.env.example

# Node
node_modules/
dist/
build/
.vite/
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/

# runtime db
api/app.db

# blind-test deliverables: the kit's CSVs stay ignored, but the three submission
# outputs must be committed (see SUBMISSION.md §4). Last matching rule wins.
!submission/*.csv
